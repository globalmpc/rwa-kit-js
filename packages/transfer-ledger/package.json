{
  "name": "@globalmpc/transfer-ledger",
  "version": "0.1.0",
  "description": "Check a bulk token payout against what was meant to be paid. Reads every ERC-20 transfer by transaction hash and log index, so one multisend counts as hundreds of payments, and reports missing payments, duplicates and overpayments. Runs offline in CI, with a non-zero exit code when a round is not clean.",
  "keywords": [
    "evm",
    "bnb-chain",
    "bsc",
    "erc20",
    "multisend",
    "payouts",
    "reconciliation",
    "dividends",
    "rwa"
  ],
  "license": "MIT",
  "author": "Global MPC",
  "homepage": "https://github.com/globalmpc/rwa-kit-js/tree/main/packages/transfer-ledger#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/globalmpc/rwa-kit-js.git",
    "directory": "packages/transfer-ledger"
  },
  "bugs": {
    "url": "https://github.com/globalmpc/rwa-kit-js/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.14.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "transfer-ledger": "./dist/bin/transfer-ledger.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@globalmpc/evm-log-walker": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
