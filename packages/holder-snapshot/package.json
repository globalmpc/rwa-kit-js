{
  "name": "@globalmpc/holder-snapshot",
  "version": "0.1.0",
  "description": "Who held a token at a given block, and what each holder is owed. Replays every ERC-20 Transfer since creation into balances, checks them against the token's own balanceOf and totalSupply, then splits a payout pool pro-rata or equally with exclusions, a minimum balance and a per-wallet cap. Writes a payout CSV that address-guard and transfer-ledger read.",
  "keywords": [
    "evm",
    "bnb-chain",
    "bsc",
    "erc20",
    "snapshot",
    "holders",
    "airdrop",
    "dividends",
    "payouts",
    "rwa"
  ],
  "license": "MIT",
  "author": "Global MPC",
  "homepage": "https://github.com/globalmpc/rwa-kit-js/tree/main/packages/holder-snapshot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/globalmpc/rwa-kit-js.git",
    "directory": "packages/holder-snapshot"
  },
  "bugs": {
    "url": "https://github.com/globalmpc/rwa-kit-js/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.14.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "holder-snapshot": "./dist/bin/holder-snapshot.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@globalmpc/evm-log-walker": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
